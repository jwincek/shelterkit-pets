{
  "_comment_rewrite": "Taxonomy names carry the post type's vcps_ prefix since migration 9; until then they were pet_*, a three-letter prefix any other pet plugin could also register. Two public surfaces keep the old names on purpose. rewrite.slug keeps them in URLs, so an indexed /pet_breed/beagle/ still resolves. rest_base keeps them in the REST API, /wp/v2/pet_breed and /wp/v2/vcps_pet?pet_breed=, so clients on other sites, such as a companion plugin reading this site's pets, keep working whichever site updates first.",
  "taxonomies": {
    "vcps_pet_status": {
      "post_types": [
        "vcps_pet"
      ],
      "labels": {
        "singular": "Status",
        "plural": "Statuses"
      },
      "public": true,
      "hierarchical": false,
      "show_in_rest": true,
      "show_admin_column": true,
      "_comment_default_term": "Assigned by WordPress when a pet is saved with no status chosen. Hand-created pets would otherwise have none, and the listing grid filters on 'available' — so they would render on their own page but never on the archive.",
      "default_term": "available",
      "default_terms": [
        {
          "slug": "available",
          "name": "Available"
        },
        {
          "slug": "pending",
          "name": "Adoption Pending"
        },
        {
          "slug": "adopted",
          "name": "Adopted"
        },
        {
          "slug": "hold",
          "name": "On Hold"
        }
      ],
      "rewrite": {
        "slug": "pet_status"
      },
      "rest_base": "pet_status"
    },
